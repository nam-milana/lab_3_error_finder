<Window
  x:Class="ErrorFinder.Views.MainWindow"
  xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
  xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
  Title="Поиск 'error' в TXT файлах"
  Height="500"
  Width="700"
>
  <Grid Margin="10">
    <Grid.RowDefinitions>
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="Auto" />
      <RowDefinition Height="*" />
      <RowDefinition Height="Auto" />
    </Grid.RowDefinitions>

    <!-- Выбор папки -->
    <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,5">
      <TextBox
        Text="{Binding SelectedFolder, UpdateSourceTrigger=PropertyChanged}"
        Width="400"
        Margin="0,0,5,0"
      />
      <Button Command="{Binding SelectFolderCommand}" Content="Обзор..." Width="80" />
    </StackPanel>

    <!-- Кнопки управления -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,10">
      <Button Command="{Binding StartCommand}" Content="Старт" Width="80" Margin="0,0,5,0" />
      <Button Command="{Binding CancelCommand}" Content="Отмена" Width="80" />
    </StackPanel>

    <!-- Прогресс -->
    <TextBlock Grid.Row="2" Text="{Binding Status}" Margin="0,5" />
    <ProgressBar Grid.Row="3" Value="{Binding Percent}" Height="20" Margin="0,5" />

    <GroupBox Grid.Row="4" Header="Ход обработки (последние файлы)" Margin="0,5">
      <ListBox
        ItemsSource="{Binding ProcessingLog}"
        Height="100"
        Background="Transparent"
        BorderThickness="0"
        FontFamily="Consolas"
        FontSize="12"
      />
    </GroupBox>

    <!-- Список найденных файлов -->
    <GroupBox Grid.Row="5" Header="Файлы, содержащие 'error'" Margin="0,10">
      <ListBox ItemsSource="{Binding ErrorFiles}" Height="150" />
    </GroupBox>
  </Grid>
</Window>
